APP_NAME="Leave API"
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# MySQL connection: mysql+pymysql://user:password@host:port/database?charset=utf8mb4
DATABASE_URL=mysql+pymysql://leave_user:change-me@localhost:3306/leave_db?charset=utf8mb4

# Allowed browser origins, written as a JSON list. Leave empty if no browser app calls the API.
CORS_ORIGINS=[]

# Only used by the tests. Must point at a throwaway database: the tests create and drop tables in it.
# TEST_DATABASE_URL=mysql+pymysql://leave_user:change-me@localhost:3306/leave_db_test?charset=utf8mb4
